        <mxCell id="4" vertex="1" parent="1" value="&lt;div style=&quot;font-size:29.0px;font-weight:normal;line-height:1.35;color:#303B40;&quot;&gt;평소처럼 요청&lt;/div&gt;&lt;div style=&quot;font-size:21.0px;font-weight:normal;line-height:1.35;color:#303B40;&quot;&gt;그냥 말하기&lt;/div&gt;" style=";whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Malgun Gothic;fontColor=#303B40;fillColor=#e2edf8;spacing=12;rounded=1;sketch=1;jiggle=2;strokeWidth=2;strokeColor=#59656b;fillOpacity=100;opacity=100;fillStyle=solid;gradientColor=none;glass=0;fontStyle=0;">
          <mxGeometry as="geometry" x="470.0" y="60.0" width="430.0" height="160.0" />
        </mxCell>
        <mxCell id="5" vertex="1" parent="1" value="&lt;div style=&quot;font-size:29.0px;font-weight:normal;line-height:1.35;color:#303B40;&quot;&gt;Claude가 바로 처리&lt;/div&gt;&lt;div style=&quot;font-size:21.0px;font-weight:normal;line-height:1.35;color:#303B40;&quot;&gt;간단한 질문, 작은 수정에 알맞아요&lt;/div&gt;" style=";whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Malgun Gothic;fontColor=#303B40;fillColor=#e2edf8;spacing=12;rounded=1;sketch=1;jiggle=2;strokeWidth=2;strokeColor=#59656b;fillOpacity=100;opacity=100;fillStyle=solid;gradientColor=none;glass=0;fontStyle=0;">
          <mxGeometry as="geometry" x="1000.0" y="60.0" width="760.0" height="160.0" />
        </mxCell>
        <mxCell id="6" vertex="1" parent="1" value="&lt;div style=&quot;font-size:29.0px;font-weight:normal;line-height:1.35;color:#303B40;&quot;&gt;워크플로 호출&lt;/div&gt;&lt;div style=&quot;font-size:19.0px;font-weight:normal;line-height:1.35;color:#303B40;&quot;&gt;/subagent 요청 또는 &amp;quot;서브에이전트로 해줘&amp;quot;&lt;/div&gt;" style=";whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Malgun Gothic;fontColor=#303B40;fillColor=#f3eadc;spacing=12;rounded=1;sketch=1;jiggle=2;strokeWidth=2;strokeColor=#59656b;fillOpacity=100;opacity=100;fillStyle=solid;gradientColor=none;glass=0;fontStyle=0;">
          <mxGeometry as="geometry" x="470.0" y="400.0" width="430.0" height="160.0" />
        </mxCell>
        <mxCell id="7" vertex="1" parent="1" value="&lt;div style=&quot;font-size:29.0px;font-weight:normal;line-height:1.35;color:#303B40;&quot;&gt;PM이 분류&lt;/div&gt;&lt;div style=&quot;font-size:19.0px;font-weight:normal;line-height:1.35;color:#303B40;&quot;&gt;간단하면 바로 처리, 크면 워크플로가 나서요&lt;/div&gt;" style=";whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Malgun Gothic;fontColor=#303B40;fillColor=#e2edf8;spacing=12;rounded=1;sketch=1;jiggle=2;strokeWidth=2;strokeColor=#59656b;fillOpacity=100;opacity=100;fillStyle=solid;gradientColor=none;glass=0;fontStyle=0;">
