        <mxCell id="3" vertex="1" parent="1" value="&lt;div style=&quot;font-size:29.0px;font-weight:normal;line-height:1.35;color:#303B40;&quot;&gt;내 요청&lt;/div&gt;" style=";whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Malgun Gothic;fontColor=#303B40;fillColor=#f3eadc;spacing=12;rounded=1;sketch=1;jiggle=2;strokeWidth=2;strokeColor=#59656b;fillOpacity=100;opacity=100;fillStyle=solid;gradientColor=none;glass=0;fontStyle=0;">
          <mxGeometry as="geometry" x="40.0" y="280.0" width="320.0" height="130.0" />
