        </mxCell>
        <mxCell id="8" vertex="1" parent="1" value="&lt;div style=&quot;font-size:29.0px;font-weight:normal;line-height:1.35;color:#303B40;&quot;&gt;기획 → 확인 → 개발 → 검증&lt;/div&gt;&lt;div style=&quot;font-size:21.0px;font-weight:normal;line-height:1.35;color:#303B40;&quot;&gt;호출처, 계약, 빠뜨린 요구를 챙겨요&lt;/div&gt;" style=";whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Malgun Gothic;fontColor=#303B40;fillColor=#e8e1f0;spacing=12;rounded=1;sketch=1;jiggle=2;strokeWidth=2;strokeColor=#59656b;fillOpacity=100;opacity=100;fillStyle=solid;gradientColor=none;glass=0;fontStyle=0;">
