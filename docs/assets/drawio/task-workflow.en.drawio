        <mxCell id="2" vertex="1" parent="1" value="" style="shape=rectangle;fillColor=#FAF8F2;strokeColor=none;locked=1;connectable=0;">
          <mxGeometry as="geometry" x="0" y="0" width="2000" height="700" />
        </mxCell>
        <mxCell id="3" vertex="1" parent="1" value="&lt;div style=&quot;font-size:24.0px;font-weight:normal;line-height:1.35;color:#303B40;&quot;&gt;G0, /subagent, Triage&lt;/div&gt;&lt;div style=&quot;font-size:18.0px;font-weight:normal;line-height:1.35;color:#303B40;&quot;&gt;classify as Q, L1, L2, L3&lt;/div&gt;" style=";whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Malgun Gothic;fontColor=#303B40;fillColor=#e2edf8;spacing=12;rounded=1;sketch=1;jiggle=2;strokeWidth=2;strokeColor=#59656b;fillOpacity=100;opacity=100;fillStyle=solid;gradientColor=none;glass=0;fontStyle=0;">
          <mxGeometry as="geometry" x="40.0" y="110.0" width="288.0" height="245.0" />
        </mxCell>
        <mxCell id="4" vertex="1" parent="1" value="&lt;div style=&quot;font-size:24.0px;font-weight:normal;line-height:1.35;color:#303B40;&quot;&gt;G1, Plan&lt;/div&gt;&lt;div style=&quot;font-size:18.0px;font-weight:normal;line-height:1.35;color:#303B40;&quot;&gt;requirements, acceptance&lt;/div&gt;&lt;div style=&quot;font-size:18.0px;font-weight:normal;line-height:1.35;color:#303B40;&quot;&gt;criteria, impact&lt;/div&gt;" style=";whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Malgun Gothic;fontColor=#303B40;fillColor=#eaf0df;spacing=12;rounded=1;sketch=1;jiggle=2;strokeWidth=2;strokeColor=#59656b;fillOpacity=100;opacity=100;fillStyle=solid;gradientColor=none;glass=0;fontStyle=0;">
          <mxGeometry as="geometry" x="365.0" y="110.0" width="288.0" height="245.0" />
        </mxCell>
        <mxCell id="5" vertex="1" parent="1" value="&lt;div style=&quot;font-size:24.0px;font-weight:normal;line-height:1.35;color:#303B40;&quot;&gt;G2, Confirm&lt;/div&gt;&lt;div style=&quot;font-size:18.0px;font-weight:normal;line-height:1.35;color:#303B40;&quot;&gt;L3: always ask the user&lt;/div&gt;" style=";whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Malgun Gothic;fontColor=#303B40;fillColor=#f3eadc;spacing=12;rounded=1;sketch=1;jiggle=2;strokeWidth=2;strokeColor=#59656b;fillOpacity=100;opacity=100;fillStyle=solid;gradientColor=none;glass=0;fontStyle=0;">
          <mxGeometry as="geometry" x="690.0" y="110.0" width="288.0" height="245.0" />
        </mxCell>
        <mxCell id="6" vertex="1" parent="1" value="&lt;div style=&quot;font-size:24.0px;font-weight:normal;line-height:1.35;color:#303B40;&quot;&gt;G3, Build&lt;/div&gt;&lt;div style=&quot;font-size:18.0px;font-weight:normal;line-height:1.35;color:#303B40;&quot;&gt;approved files only,&lt;/div&gt;&lt;div style=&quot;font-size:18.0px;font-weight:normal;line-height:1.35;color:#303B40;&quot;&gt;sequential writes&lt;/div&gt;" style=";whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Malgun Gothic;fontColor=#303B40;fillColor=#f8e6cd;spacing=12;rounded=1;sketch=1;jiggle=2;strokeWidth=2;strokeColor=#59656b;fillOpacity=100;opacity=100;fillStyle=solid;gradientColor=none;glass=0;fontStyle=0;">
          <mxGeometry as="geometry" x="1015.0" y="110.0" width="288.0" height="245.0" />
        </mxCell>
        <mxCell id="7" vertex="1" parent="1" value="&lt;div style=&quot;font-size:24.0px;font-weight:normal;line-height:1.35;color:#303B40;&quot;&gt;G4, Independent QA&lt;/div&gt;&lt;div style=&quot;font-size:18.0px;font-weight:normal;line-height:1.35;color:#303B40;&quot;&gt;check records, checklist&lt;/div&gt;" style=";whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Malgun Gothic;fontColor=#303B40;fillColor=#e8e1f0;spacing=12;rounded=1;sketch=1;jiggle=2;strokeWidth=2;strokeColor=#59656b;fillOpacity=100;opacity=100;fillStyle=solid;gradientColor=none;glass=0;fontStyle=0;">
          <mxGeometry as="geometry" x="1340.0" y="110.0" width="288.0" height="245.0" />
        </mxCell>
        <mxCell id="8" vertex="1" parent="1" value="&lt;div style=&quot;font-size:24.0px;font-weight:normal;line-height:1.35;color:#303B40;&quot;&gt;G5, Final report&lt;/div&gt;&lt;div style=&quot;font-size:18.0px;font-weight:normal;line-height:1.35;color:#303B40;&quot;&gt;per-requirement status,&lt;/div&gt;&lt;div style=&quot;font-size:18.0px;font-weight:normal;line-height:1.35;color:#303B40;&quot;&gt;unverified&lt;/div&gt;" style=";whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Malgun Gothic;fontColor=#303B40;fillColor=#e2edf8;spacing=12;rounded=1;sketch=1;jiggle=2;strokeWidth=2;strokeColor=#59656b;fillOpacity=100;opacity=100;fillStyle=solid;gradientColor=none;glass=0;fontStyle=0;">
          <mxGeometry as="geometry" x="1665.0" y="110.0" width="288.0" height="245.0" />
        </mxCell>
        <mxCell id="9" vertex="1" parent="1" value="&lt;div style=&quot;font-size:21.0px;font-weight:normal;line-height:1.35;color:#303B40;&quot;&gt;Q, L1: handled directly by the PM&lt;/div&gt;&lt;div style=&quot;font-size:18.0px;font-weight:normal;line-height:1.35;color:#303B40;&quot;&gt;L1: self-check, raise to L2 if impact appears&lt;/div&gt;" style=";whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Malgun Gothic;fontColor=#303B40;fillColor=#e2edf8;spacing=12;rounded=1;sketch=1;jiggle=2;strokeWidth=2;strokeColor=#59656b;fillOpacity=100;opacity=100;fillStyle=solid;gradientColor=none;glass=0;fontStyle=0;">
